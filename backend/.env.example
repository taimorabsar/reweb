# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/realestate?schema=public"

# JWT (change these to random strings in production)
JWT_SECRET="change-this-to-random-string-16chars"
JWT_REFRESH_SECRET="change-this-to-different-random-16chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AWS S3 (your actual credentials)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_KEY"
AWS_S3_BUCKET_NAME="realestatetask"

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
